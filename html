        // Set Filter Tabs
        function setFilter(filter, btn) {
            currentFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('bg-f1Red', 'text-white');
                b.classList.add('bg-surfaceLight', 'text-gray-300');
            });
            btn.classList.add('bg-f1Red', 'text-white');
            btn.classList.remove('bg-surfaceLight', 'text-gray-300');
            filterGrid();
        }

        // Search & Filter combined
        function filterGrid() {
            const query = document.getElementById('driverSearch').value.toLowerCase().trim();
            
            let filtered = f1Data.filter(team => {
                const matchPU = (currentFilter === 'all') || team.engine.toLowerCase().includes(currentFilter.toLowerCase());
                
                const matchQuery = !query || 
                    team.team.toLowerCase().includes(query) ||
                    team.shortTeam.toLowerCase().includes(query) ||
                    team.engine.toLowerCase().includes(query) ||
                    team.drivers.some(d => 
                        d.name.toLowerCase().includes(query) || 
                        d.number.toString().includes(query) ||
                        d.code.toLowerCase().includes(query)
                    );

                return matchPU && matchQuery;
            });

            renderGrid(filtered);
        }

