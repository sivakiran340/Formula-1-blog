            document.getElementById('modalFlag').innerText = driver.flag;
            document.getElementById('modalTeamName').innerText = team.team;
            document.getElementById('modalDriverName').innerText = driver.name;

            document.getElementById('modalStarts').innerText = driver.starts;
            document.getElementById('modalWins').innerText = driver.wins;
            document.getElementById('modalPodiums').innerText = driver.podiums;
            document.getElementById('modalTitles').innerText = driver.titles;

