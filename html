            document.getElementById('modalEngine').innerText = team.engineFull;

            const headerBg = document.getElementById('modalHeaderBg');
            headerBg.style.backgroundColor = team.color;

            const modal = document.getElementById('driverModal');
            modal.classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('driverModal').classList.add('hidden');
        }

        // Article Modal Viewer
        const articlesData = {
            'hamilton-ferrari': {
                title: "Hamilton in Maranello: The High-Stakes Partnership with Charles Leclerc",
                body: `
                    <p>The 2026 regulations mark the formal culmination of Lewis Hamilton's monumental arrival in Italy. Wearing the scarlet red of Scuderia Ferrari alongside Charles Leclerc, the pairing represents arguably the most accomplished qualifying and racecraft duo on the grid.</p>
                    <p>Technically, the 2026 rule reset affords Ferrari an uncompromised fresh sheet of paper. With the removal of the troublesome MGU-H and the mandate for 100% sustainable fuels, Ferrari's combustion specialists in Maranello have spent 30 months running test benches to optimize rapid-flame propagation fuels in conjunction with Shell.</p>
                    <p>Hamilton's feedback during winter simulator testing has focused extensively on front-axle turn-in responsiveness—an area where the 100mm narrower 2026 chassis will require delicate balance to match Leclerc's aggressive, oversteer-tolerant setup preference.</p>
                `
            },
            'audi-entry': {
                title: "Inside Audi's F1 Launch: German Engineering Meets Swiss Precision",
                body: `
                    <p>Audi's takeover of the Sauber motorsport facility at Hinwil, paired with their dedicated engine development centre at Neuburg an der Donau, finally takes to the track in 2026 as a complete factory outfit.</p>
                    <p>Nico Hülkenberg was signed early to guide powertrain integration alongside former Ferrari team boss Mattia Binotto. With young Brazilian sensation Gabriel Bortoleto rounding out the roster, Audi possesses an ideal blend of veteran developmental acumen and youthful flair.</p>
                    <p>Neuburg engineers report that Audi's bespoke 350kW MGU-K electric motor features state-of-the-art silicon carbide inverter technology, aiming to minimize cooling drag through the narrower sidepod apertures permitted by the 2026 chassis regulations.</p>
                `
            },
            'engine-wars': {
                title: "The 2026 Engine Wars: Ford, Honda, Mercedes, and Ferrari Battle For Supremacy",
                body: `
                    <p>For the first time since the turbo-hybrid introduction in 2014, the power unit hierarchy faces total disruption. Red Bull Ford Powertrains enters the fray with an entirely new engine campus in Milton Keynes, backed by Ford's electric motor and battery expertise from Detroit.</p>
                    <p>Aston Martin steps into full works partner status with Honda, who bring their championship-winning pedigree directly to Lawrence Stroll's newly constructed Silverstone wind tunnel and technology campus under Adrian Newey.</p>
                    <p>Crucially, with active aerodynamics operating in both high-downforce (Z-Mode) and low-drag (X-Mode), power unit energy management becomes a chess match. Drivers will no longer merely stomp the throttle; automated electrical deployment algorithms will balance charge harvesting and overtaking boosts on straightaways.</p>
                `
            }
        };

        function readArticle(key) {
            const article = articlesData[key];
            if (!article) return;

            document.getElementById('articleModalTitle').innerText = article.title;
            document.getElementById('articleModalBody').innerHTML = article.body;
            document.getElementById('articleModal').classList.remove('hidden');
        }

        function closeArticleModal() {
            document.getElementById('articleModal').classList.add('hidden');
        }

        // Newsletter handler
        function handleSubscribe(e) {
            e.preventDefault();
            const input = document.getElementById('newsletterEmail');
            const msg = document.getElementById('subscribeMsg');
            if (input.value) {
                msg.innerText = "✓ Welcome to the 2026 Paddock Club dispatch!";
                msg.classList.remove('hidden');
                input.value = '';
                setTimeout(() => {
                    msg.classList.add('hidden');
                }, 4000);
            }
        }

        // Close modals on escape key or backdrop click
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeModal();
                closeArticleModal();
            }
        });

        document.getElementById('driverModal').addEventListener('click', (e) => {
            if (e.target.id === 'driverModal') closeModal();
        });

        document.getElementById('articleModal').addEventListener('click', (e) => {
            if (e.target.id === 'articleModal') closeArticleModal();
        });

        // Initial Grid Render on load
        window.onload = function() {
            renderGrid(f1Data);
        };
    </script>
</body>
</html>
